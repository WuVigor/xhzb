# Spring profile
SPRING_PROFILES_ACTIVE=prod

# MySQL
DB_URL=jdbc:mysql://192.168.100.168:3306/xhzb?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=请填写数据库密码

# Redis Stack（当前虚拟机映射端口为 6378，且未配置密码）
REDIS_HOST=192.168.100.168
REDIS_PORT=6378
REDIS_PASSWORD=

# Production AI: Alibaba Cloud Model Studio OpenAI-compatible API
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
# 文档使用 OPENAI_API_KEY，值填写阿里云百炼 API Key
OPENAI_API_KEY=请填写百炼API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_CHAT_MODEL=qwen3.6-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# OSS is optional. Keep disabled to use the project's local file fallback.
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# Replace with a long random value before production use.
TOKEN_SECRET=请填写随机Token密钥
